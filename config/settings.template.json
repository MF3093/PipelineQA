{
  "description": "Project-specific permission allowlist for QA pipeline agents. Copy this file to {PROJECT_OUTPUT}/.claude/settings.json after filling in paths.",
  "permissions": {
    "allow": [
      "read_comment": "=== MCP Tools ===",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__searchJiraIssuesUsingJql",
      "read_comment": "=== Registry Files (Orchestrator + all agents) ===",
      "Read(registry/pipeline-state.json)",
      "Write(registry/pipeline-state.json)",
      "Read(registry/fetched-stories.json)",
      "Write(registry/fetched-stories.json)",
      "Read(registry/fetched-epics.json)",
      "Write(registry/fetched-epics.json)",
      "read_comment": "=== Raw Story/Epic Snapshots (Fetcher writes, Parser reads) ===",
      "Write(stories/raw/*)",
      "Read(stories/raw/*)",
      "Write(epics/raw/*)",
      "Read(epics/raw/*)",
      "read_comment": "=== Parsed Stories/Epics (Parser writes, Story Analyzer/Prioritizer/TC Generator read) ===",
      "Write(stories/parsed/*)",
      "Read(stories/parsed/*)",
      "Write(epics/parsed/*)",
      "Read(epics/parsed/*)",
      "read_comment": "=== Project Context (Context Builder writes, Story Prioritizer/TC Generator read) ===",
      "Write(context/project-context.md)",
      "Read(context/project-context.md)",
      "read_comment": "=== Strategy & Prioritization (Story Prioritizer writes, TC Generator/TC Reviewer read) ===",
      "Write(strategy/priority-matrix.md)",
      "Read(strategy/priority-matrix.md)",
      "Write(strategy/strategy-versions/*)",
      "Read(strategy/strategy-versions/*)",
      "read_comment": "=== Test Cases (TC Generator writes, TC Reviewer reads) ===",
      "Write(test-cases/*)",
      "Read(test-cases/*)",
      "read_comment": "=== Tracking & Assumptions (Story Analyzer/Prioritizer/TC Generator write, Orchestrator reads) ===",
      "Write(tracking/assumptions.md)",
      "Read(tracking/assumptions.md)",
      "Write(tracking/corrections-log.md)",
      "Read(tracking/corrections-log.md)",
      "Write(tracking/logs/*)",
      "Read(tracking/logs/*)",
      "Write(tracking/reviews/*)",
      "Read(tracking/reviews/*)",
      "read_comment": "=== Config Files (all agents read source-config, Orchestrator reads/writes run-log template) ===",
      "Read(config/source-config.md)",
      "Write(config/source-config.md)",
      "Read(config/run-log.template.md)",
      "Read(config/corrections-log.template.md)",
      "read_comment": "=== Screenshots & Extra Resources (TC Generator reads) ===",
      "Read(screenshots/*)",
      "Read(ExtraResources/*)"
    ]
  }
}
